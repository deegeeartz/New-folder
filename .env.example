# Frontend Environment Variables (prefix with VITE_)
# API Base URL for production (leave empty for local proxy)
VITE_API_BASE_URL=

# Backend Environment Variables (server-side only)

# Resend API key for contact form email delivery (https://resend.com — free: 3,000 emails/month)
# 1. Sign up at resend.com  2. Add & verify your sending domain  3. Create an API key and paste it here
RESEND_API_KEY=re_your_api_key_here
CONTACT_TO_EMAIL=info@yourdomain.com
CONTACT_FROM_EMAIL=Quonote Contact Form <onboarding@resend.dev>
# Gemini API Key - Get from https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Server Configuration
PORT=3001
NODE_ENV=production

# CORS - Allowed Origins (comma-separated)
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
